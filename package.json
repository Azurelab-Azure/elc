{
  "name": "circuit-simulation-lab",
  "version": "1.0.0",
  "description": "免费开源的电路仿真与教学平台",
  "main": "electron/main.js",
  "author": "Circuit Simulation Lab Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "vite & electron .",
    "lint": "eslint . --ext .vue,.js,.ts --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "generate-catalog": "node scripts/generate-catalog.js",
    "validate": "node scripts/validate-files.js",
    "release": "node scripts/release-notes.js"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.0",
    "axios": "^1.6.0",
    "lottie-web": "^5.12.2",
    "marked": "^11.0.0",
    "pinia": "^2.1.7",
    "three": "^0.160.0",
    "uuid": "^9.0.1",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.4.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@types/three": "^0.160.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.3",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.16",
    "electron": "^27.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.18.1",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.2",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^1.8.22"
  }
}